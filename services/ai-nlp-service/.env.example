# ── App ──────────────────────────────────────────────────
APP_NAME="AI NLP Service"
DEBUG=false
PORT=8000

# ── Model artefacts ──────────────────────────────────────
MODEL_PATH=./models/best_model.pt
EVIDENCE_PATH=./models/evidence_list_clean.json
MODEL_NAME=HooshvareLab/bert-fa-base-uncased
MODEL_VERSION=parsbert-v1

# ── Inference ────────────────────────────────────────────
THRESHOLD=0.3
MAX_LEN=128
# Empty = auto-detect (cuda if available, else cpu). e.g. "cuda", "cuda:0", "cpu"
DEVICE=

# ── Security ─────────────────────────────────────────────
INTERNAL_API_KEY=internal-secret-key-12345
# DEV_MODE=true skips the internal API key check — local curl testing only.
# NEVER enable in production.
DEV_MODE=false
