# ── Visit Intake Service ─────────────────────────────────
# Copy to services/visit-intake-service/.env and adjust.
# In docker-compose these are set in the visit-intake-service
# environment block; this file is for local (non-docker) runs.

APP_NAME="Visit Intake Service"
DEBUG=false

# Database (database-per-service: visits_db)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/visits_db

# JWT
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256

# Object Storage (MinIO/S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=visit-files
MINIO_SECURE=false

# Internal API Security (AI services call these endpoints)
INTERNAL_API_KEY=internal-secret-key-12345

# medical-record-service (sync hook: register visits on records)
MEDICAL_RECORD_SERVICE_URL=http://localhost:8000

# ── ai-nlp-service (Persian evidence extraction) ─────────
# http://ai-nlp-service:8000  = docker network name (compose)
# http://localhost:8005       = local run of the NLP service
AI_NLP_SERVICE_URL=http://ai-nlp-service:8000
AI_NLP_ENABLED=true
AI_NLP_TIMEOUT_SECONDS=30
# Patient text is truncated to this many chars before being sent
# (ai-nlp-service itself truncates at 5000).
AI_NLP_TEXT_MAX_CHARS=5000
# Optional: override the model threshold (default: use the service's own
# threshold, 0.3). Must be 0 < x <= 1.
#AI_NLP_THRESHOLD=0.3

# File Upload
MAX_ATTACHMENT_SIZE_MB=25
