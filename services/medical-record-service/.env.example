# ---- App ----
APP_NAME=Medical Record Service
DEBUG=true

# ---- Database (database-per-service: medical_records_db) ----
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5435/medical_records_db

# ---- JWT (fallback validation when request does not come through the gateway) ----
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256

# ---- MinIO ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=medical-records
MINIO_SECURE=false

# ---- Internal API ----
INTERNAL_API_KEY=change-me-in-production-32-char-min

# ---- File upload ----
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,audio/mpeg,audio/wav,video/mp4

# ---- visit-intake-service (doctor endpoint: find patients treated by doctor) ----
VISIT_INTAKE_SERVICE_URL=http://localhost:8004
