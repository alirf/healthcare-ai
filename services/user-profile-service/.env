# App
DEBUG=false
APP_NAME=User Profile Service

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@profile-db:5432/profile_db

# JWT (public key from Auth Service)
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=profile-images
MINIO_SECURE=false

# Internal API Security
INTERNAL_API_KEY=change-me-in-production-32-char-min

# File Upload
MAX_AVATAR_SIZE_MB=5